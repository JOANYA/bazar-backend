PORT=3000
NODE_ENV=development

# --- MySQL (Workbench) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456
DB_NAME=db_bazar_vecino
DB_SSL=false
# Zona horaria del negocio como desfase fijo. Perú = -05:00 (no tiene horario de verano).
# Importante: define qué es "hoy" para las ventas y el cierre de caja.
DB_TIMEZONE=-05:00

# --- Seguridad ---
# Genera una clave larga:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRA_TIENDA=7d
JWT_EXPIRA_ADMIN=12h

# Orígenes del frontend permitidos por CORS, separados por coma
FRONTEND_URL=http://localhost:4200,http://localhost:5173
# Pon 1 si el backend corre detrás de un proxy (Render, Railway, Nginx...)
TRUST_PROXY=0

# --- Primer administrador (lo usa: npm run sembrar:admin) ---
ADMIN_NOMBRE=joanya
ADMIN_CORREO=joanya@gmail.com
ADMIN_PASSWORD=123456
